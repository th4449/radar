# Copy to .env, which git ignores. Never commit real values.

# Public contact address sent in the collector's user agent.
RADAR_CONTACT=

# Optional model triage. Leave unset to keep it off. See config/triage.yaml.
# The API key itself is a secret: set ANTHROPIC_API_KEY as a GitHub or Supabase secret,
# never in a file that is committed.
RADAR_TRIAGE=
RADAR_TRIAGE_MONTHLY_CAP_USD=
